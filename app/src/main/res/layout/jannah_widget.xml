<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#EFE6D6">

    <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JANNAH"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:textColor="#A63414" />

    <TextView
        android:id="@+id/widget_prayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Fajr"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2B1410"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="05:46"
        android:textSize="14sp"
        android:textColor="#7A6656" />

    <TextView
        android:id="@+id/widget_tahajjud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tahajjud · 02:34"
        android:textSize="12sp"
        android:textColor="#D9481F"
        android:textStyle="bold" />
</LinearLayout>
